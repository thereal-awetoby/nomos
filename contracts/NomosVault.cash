pragma cashscript ^0.10.0;

// Nomos — On-chain spend mandate (covenant) for Bitcoin Cash
// Mutable state (spentToday, dayMarker) stored in NFT commitment (CashTokens).
// Immutable config (owner, limit, allowlist, etc.) in constructor params.
// Violate → refuse on-chain. Obey → pay + receipt.

contract NomosVault(
    pubkey ownerPk,
    pubkey agentPk,
    int dailyLimitSats,
    bool allowlistEnabled,
    bytes20 allowedAddr1,
    bytes20 allowedAddr2,
    bytes20 allowedAddr3,
    bytes20 allowedAddr4,
    bytes20 allowedAddr5,
    pubkey rescuePk
) {
    // ── Spend: Owner or Agent, under mandate rules ──────────────
    // NFT commitment layout: spentTodaySats (8 bytes LE) || dayMarker (8 bytes LE)
    function spend(sig spenderSig, pubkey spenderPk, int amount) {
        // Caller must be owner or agent
        require(spenderPk == ownerPk || spenderPk == agentPk);
        require(checkSig(spenderSig, spenderPk));
        require(amount > 0);

        // Locktime must be unix timestamp (not block height)
        require(tx.locktime >= 500000000);

        // ── Read mutable state from input NFT commitment ──
        bytes inputCommitment = tx.inputs[this.activeInputIndex].nftCommitment;
        bytes spentBytes, bytes dayBytes = inputCommitment.split(8);
        int spentTodaySats = int(spentBytes);
        int dayMarker = int(dayBytes);

        // ── Day reset logic ──
        int currentDay = tx.locktime / 86400;
        int effectiveSpent = 0;
        if (currentDay == dayMarker) {
            effectiveSpent = spentTodaySats;
        }

        // ── Daily limit check ──
        require(effectiveSpent + amount <= dailyLimitSats);

        // ── Allowlist check ──
        if (allowlistEnabled) {
            bytes lockScript = tx.outputs[1].lockingBytecode;
            bytes p1, bytes addrAndRest = lockScript.split(3);
            bytes20 destHash, bytes p2 = addrAndRest.split(20);
            require(p1 == p1); // consume unused
            require(p2 == p2);
            require(
                destHash == allowedAddr1 ||
                destHash == allowedAddr2 ||
                destHash == allowedAddr3 ||
                destHash == allowedAddr4 ||
                destHash == allowedAddr5
            );
        }

        // ── Covenant continuation ──
        // Output 0 must keep the same locking bytecode (same contract + params)
        require(tx.outputs[0].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode);

        // Output 0 NFT must carry updated state
        int newSpent = effectiveSpent + amount;
        bytes newCommitment = bytes8(newSpent) + bytes8(currentDay);
        require(tx.outputs[0].nftCommitment == newCommitment);

        // Preserve the token category (same NFT lineage)
        require(tx.outputs[0].tokenCategory == tx.inputs[this.activeInputIndex].tokenCategory);

        // ── Value checks ──
        require(tx.outputs[1].value == amount);
        int minerFee = 1000;
        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value - amount - minerFee);
    }

    // ── Set Mandate: Owner only ─────────────────────────────────
    // Owner spends current vault, builds a new NomosVault deployment
    // with updated params. No covenant on outputs — owner has full
    // authority; mandate is self-imposed.
    function setMandate(sig ownerSig) {
        require(checkSig(ownerSig, ownerPk));
    }

    // ── Rescue: Owner + rescue co-signer ────────────────────────
    // Bypasses daily limit. Emergency only.
    function rescue(sig ownerSig, sig rescueSig) {
        require(checkSig(ownerSig, ownerPk));
        require(checkSig(rescueSig, rescuePk));
    }
}
